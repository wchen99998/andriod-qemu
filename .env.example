AOSP_MANIFEST_URL=https://android.googlesource.com/platform/manifest
AOSP_BRANCH=android16-release
# Optional overrides. By default the scripts use repo-local paths:
# AOSP_ROOT=/absolute/path/to/work/aosp
TARGET_PRODUCT=aosp_trout_arm64
TARGET_RELEASE=trunk_staging
TARGET_VARIANT=userdebug
JOBS=0
# CCACHE_DIR=/absolute/path/to/work/ccache
CCACHE_SIZE=100G
# DIST_DIR=/absolute/path/to/artifacts/dist
# ARTIFACTS_DIR=/absolute/path/to/artifacts
ARTIFACT_NAME=
REPO_SYNC_JOBS=8
# Optional host-native smoke test override:
# REPO_SYNC_PROJECTS="platform/build platform/build/soong device/google/trout platform/system/tools/mkbootimg"
QEMU_CPUS=8
QEMU_MEMORY_MB=8192
